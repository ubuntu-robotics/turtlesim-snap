#!/bin/sh
set -eu

append_path() {
  if [ -d "$1" ]; then
    if [ -n "${2:-}" ]; then
      printf '%s:%s' "$1" "$2"
    else
      printf '%s' "$1"
    fi
  else
    printf '%s' "${2:-}"
  fi
}

qt_plugins="${QT_PLUGIN_PATH:-}"
for d in "$SNAP"/usr/lib/*/qt5/plugins "$SNAP"/gnome-platform/usr/lib/*/qt5/plugins; do
  qt_plugins="$(append_path "$d" "$qt_plugins")"
done
export QT_PLUGIN_PATH="$qt_plugins"

qt_platform_plugins="${QT_QPA_PLATFORM_PLUGIN_PATH:-}"
for d in "$SNAP"/usr/lib/*/qt5/plugins/platforms "$SNAP"/gnome-platform/usr/lib/*/qt5/plugins/platforms; do
  qt_platform_plugins="$(append_path "$d" "$qt_platform_plugins")"
done
export QT_QPA_PLATFORM_PLUGIN_PATH="$qt_platform_plugins"

# Suppress non-fatal desktop runtime noise from optional proxy/session modules.
# Keep app behavior unchanged.
unset GIO_EXTRA_MODULES
export QT_NO_SESSION_MANAGER=1

# Wayland is default via desktop-launch, but some hosts fail to resolve plugin search path.
# Force X11 backend for reliability.
export QT_QPA_PLATFORM=xcb

exec "$SNAP/opt/ros/jazzy/lib/turtlesim/turtlesim_node" "$@"
